# Copy this file to .env and set a long, unique passphrase.
# .env is git-ignored and must never be committed.
# The server refuses to start without ADMIN_PASSWORD (minimum 14 characters).
ADMIN_PASSWORD=

# Optional. Defaults shown.
# HOST=127.0.0.1
# PORT=3000

# Set true only on an HTTPS deployment. Requires HTTPS, or the browser
# will drop the session cookie.
# COOKIE_SECURE=false

# Set true only behind a reverse proxy that sets X-Forwarded-For.
# Otherwise clients could spoof their IP and evade rate limiting.
# TRUST_PROXY=false

# Split deployment (Netlify frontend + Render API):
# The Netlify site URL. Lets the Render API accept the proxied request's Origin.
# PUBLIC_ORIGIN=https://your-site.netlify.app
# The Render service URL, used by `npm run build` to write Netlify _redirects.
# RENDER_API_URL=https://your-api.onrender.com

# Render has no persistent disk, so the hosted SQLite database is required there.
# Leave both unset for local development (uses private/data/nexora.db).
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=
