/*
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; font-src 'self'; style-src 'self'; script-src 'self' 'sha256-/x7W7R75k8Roq0WaVRQX9blP4OufE5xbAdzklGxsgpw='; connect-src 'self'; manifest-src 'self'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Fonts are immutable by name; CSS/JS revalidate so a deploy cannot leave a
# client on an old stylesheet for a year.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=3600, must-revalidate

/premium.html
  Cache-Control: public, max-age=0, must-revalidate

/login.html
  Cache-Control: public, max-age=0, must-revalidate

/onboarding.html
  Cache-Control: public, max-age=0, must-revalidate

# Private pages and their clean aliases must never be cached.
/dashboard
  Cache-Control: no-store
/dashboard.html
  Cache-Control: no-store
/invoice/*
  Cache-Control: no-store
/invoice.html
  Cache-Control: no-store
/client
  Cache-Control: no-store
/client-portal.html
  Cache-Control: no-store
/client/login
  Cache-Control: no-store
/client-login.html
  Cache-Control: no-store
/client/invoice/*
  Cache-Control: no-store
/client-invoice.html
  Cache-Control: no-store

/api/*
  Cache-Control: no-store
